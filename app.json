{
  "expo": {
    "name": "Notelac Capture",
    "slug": "notelac-checkpoint-capture",
    "version": "0.1.0",
    "scheme": "notelac-capture",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.notelac.checkpointcapture"
    },
    "android": {
      "package": "com.notelac.checkpointcapture",
      "adaptiveIcon": {
        "backgroundColor": "#24272B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-video",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0E0F10"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Notelac Capture uses the camera to photograph and record participants at race checkpoints.",
          "microphonePermission": "Notelac Capture records audio with checkpoint videos.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Notelac Capture adds the checkpoint GPS position to each captured image."
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      "expo-asset"
    ]
  }
}
